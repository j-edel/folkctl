# Required unless you ran `folkctl auth login`.
FOLK_API_KEY=your_folk_api_key

# Optional. folk recommends pinning an API version.
FOLK_API_VERSION=2025-06-09

# Optional base URL overrides must be passed as a real environment variable,
# config file setting, or --base-url flag. cwd .env files are intentionally
# ignored for FOLK_API_BASE_URL so a project cannot redirect a stored token.
